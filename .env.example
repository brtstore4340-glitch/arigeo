# ---------------------------------------------------------------------------
# ARIGEO frontend environment variables
# Copy this file to .env.local for local development and set the same values
# in the Vercel project settings for production. See WIRING.md for details.
# ---------------------------------------------------------------------------

# Base URL of the Payload CMS that serves products, brands, etc.
# No trailing slash. The adapter in src/lib/cms.ts calls "\${NEXT_PUBLIC_CMS_URL}/api/...".
NEXT_PUBLIC_CMS_URL=https://cms-arigeo.vercel.app

# Which site the page builder reads from the shared CMS.
# Accepted values: arigeo (default) or captain-maid. See docs/CMS-PAGE-BUILDER.md.
NEXT_PUBLIC_CMS_SITE=arigeo

# Seconds between background revalidations of CMS-authored pages and sections.
NEXT_PUBLIC_CMS_REVALIDATE=60

# Optional: read private CMS collections with a server-only Payload API key.
# Prefer this over making "pages" / "sections" publicly readable. It is NOT
# prefixed with NEXT_PUBLIC_ on purpose - it must never reach the browser.
# CMS_READ_TOKEN=

# Optional: milliseconds before a CMS request is aborted (default 2500).
# A slow CMS then falls back to the hand-written pages instead of hanging.
# CMS_TIMEOUT_MS=2500

