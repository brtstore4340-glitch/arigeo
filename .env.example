# Base URL of the Payload CMS that serves products, brands, etc.
# No trailing slash. The adapter in src/lib/cms.ts calls "\${NEXT_PUBLIC_CMS_URL}/api/...".
NEXT_PUBLIC_CMS_URL=https://cms-arigeo.vercel.app
