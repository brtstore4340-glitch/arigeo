{
  "version": "1.0",
  "description": "RAM Specialist Agent Registry - Modular, On-Demand Specialists",
  "philosophy": "Load specialist context only when needed. Keep prompts short. One specialist at a time.",
  "specialists": {
    "supabase": {
      "name": "Supabase Specialist",
      "description": "Database, auth, real-time, edge functions, migrations",
      "domain": "backend-database",
      "scope": [
        "PostgreSQL schema design",
        "Row-level security (RLS)",
        "Edge functions (Deno)",
        "Real-time subscriptions",
        "Database migrations",
        "Auth setup (JWT, OAuth)",
        "Storage buckets"
      ],
      "context_rules": {
        "required": ["project_id", "current_schema", "active_functions"],
        "optional": ["recent_migrations", "rls_policies"],
        "exclude": ["ui_components", "marketing_content", "unrelated_projects"]
      },
      "prompt_size": "1500-2000 tokens",
      "used_for": [
        "Database schema review",
        "RLS policy debugging",
        "Edge function writing",
        "Migration generation",
        "Real-time setup",
        "Auth flow design"
      ],
      "example_call": {
        "user": "set up RLS for salary certificates",
        "specialist": "Supabase",
        "context": ["salary-cert schema", "user roles", "data access patterns"]
      }
    },

    "vercel": {
      "name": "Vercel Specialist",
      "description": "Deployment, serverless functions, preview URLs, analytics",
      "domain": "devops-deployment",
      "scope": [
        "Frontend deployment (Next.js, React)",
        "Serverless API routes",
        "Environment variables",
        "Preview deployments",
        "Analytics tracking",
        "Speed insights",
        "Redirects & rewrites",
        "Custom domains"
      ],
      "context_rules": {
        "required": ["project_name", "deployment_target", "build_config"],
        "optional": ["recent_deployments", "error_logs"],
        "exclude": ["database_internals", "ui_design_details"]
      },
      "prompt_size": "1200-1800 tokens",
      "used_for": [
        "Deployment troubleshooting",
        "Environment setup",
        "Preview URL generation",
        "Build optimization",
        "API route creation",
        "Analytics integration"
      ],
      "example_call": {
        "user": "deploy vehicle-booking-system to production",
        "specialist": "Vercel",
        "context": ["package.json", "build settings", "env vars needed"]
      }
    },

    "figma": {
      "name": "Figma Specialist",
      "description": "Design systems, component library, prototyping, handoff",
      "domain": "design-ui",
      "scope": [
        "Design system creation",
        "Component library management",
        "Design tokens",
        "Prototyping interactions",
        "Design handoff specs",
        "Accessibility review",
        "Design QA",
        "Responsive breakpoints"
      ],
      "context_rules": {
        "required": ["design_file_url", "component_list", "design_specs"],
        "optional": ["brand_guidelines", "accessibility_requirements"],
        "exclude": ["backend_logic", "database_queries"]
      },
      "prompt_size": "1000-1500 tokens",
      "used_for": [
        "Design system review",
        "Component spec writing",
        "Design token definition",
        "Dev handoff guidance",
        "Accessibility audit",
        "Responsive design review"
      ],
      "example_call": {
        "user": "create design system for vehicle booking",
        "specialist": "Figma",
        "context": ["brand colors", "typography", "component types"]
      }
    },

    "uiux-pro": {
      "name": "UI/UX Pro Specialist",
      "description": "User experience design, interaction patterns, usability",
      "domain": "design-ux",
      "scope": [
        "User journey mapping",
        "Information architecture",
        "Interaction patterns",
        "Accessibility (WCAG)",
        "Usability testing",
        "User research synthesis",
        "Wireframing",
        "Conversion optimization"
      ],
      "context_rules": {
        "required": ["user_flows", "target_users", "business_goals"],
        "optional": ["user_research", "competitor_analysis"],
        "exclude": ["code_implementation", "exact_pixel_measurements"]
      },
      "prompt_size": "1500-2000 tokens",
      "used_for": [
        "UX flow design",
        "Navigation structure",
        "Accessibility improvement",
        "Usability recommendations",
        "User persona alignment",
        "Conversion funnels"
      ],
      "example_call": {
        "user": "improve checkout flow for pharmacy system",
        "specialist": "UI/UX Pro",
        "context": ["current_flow", "user_types", "conversion_goal"]
      }
    },

    "cloudflare": {
      "name": "Cloudflare Specialist",
      "description": "CDN, Workers, security, analytics, performance",
      "domain": "infrastructure-cdn",
      "scope": [
        "CDN configuration",
        "Cloudflare Workers",
        "Durable Objects",
        "Rate limiting & DDoS protection",
        "WAF rules",
        "Page rules & redirects",
        "SSL/TLS setup",
        "Analytics & monitoring"
      ],
      "context_rules": {
        "required": ["domain", "traffic_patterns", "security_needs"],
        "optional": ["current_rules", "performance_metrics"],
        "exclude": ["internal_database", "user_authentication_details"]
      },
      "prompt_size": "1200-1800 tokens",
      "used_for": [
        "CDN optimization",
        "Worker function writing",
        "Security rule setup",
        "Rate limiting config",
        "Performance caching",
        "DDoS mitigation"
      ],
      "example_call": {
        "user": "set up Cloudflare for mission-control",
        "specialist": "Cloudflare",
        "context": ["domain", "traffic_type", "security_requirements"]
      }
    },

    "iot": {
      "name": "IoT Specialist",
      "description": "IoT architecture, device communication, edge computing, sensors",
      "domain": "infrastructure-iot",
      "scope": [
        "IoT device architecture",
        "MQTT/CoAP protocols",
        "Edge computing",
        "Sensor integration",
        "Device-to-cloud communication",
        "Real-time data streaming",
        "Device management",
        "Firmware updates"
      ],
      "context_rules": {
        "required": ["device_type", "communication_protocol", "data_frequency"],
        "optional": ["hardware_specs", "network_constraints"],
        "exclude": ["frontend_ui", "marketing_content"]
      },
      "prompt_size": "1500-2000 tokens",
      "used_for": [
        "Device integration planning",
        "Protocol selection",
        "Data pipeline design",
        "Edge computing setup",
        "Real-time monitoring",
        "Device management strategy"
      ],
      "example_call": {
        "user": "integrate temperature sensors for pharmacy",
        "specialist": "IoT",
        "context": ["sensor_model", "data_frequency", "alert_thresholds"]
      }
    }
  },

  "integration_rules": {
    "one_specialist_per_call": true,
    "context_loading": "load only required + relevant optional context",
    "fallback": "if specialist unavailable, RAM attempts with core 5-layer",
    "escalation": "if specialist can't solve, escalate to multi-specialist (rare)",
    "memory": "specialist results logged for synthesis"
  },

  "specialist_calling_pattern": {
    "step_1": "User request comes to RAM",
    "step_2": "Router identifies needed specialist",
    "step_3": "Load specialist agent definition",
    "step_4": "Gather minimal context (required + relevant optional)",
    "step_5": "Call specialist with focused prompt + context",
    "step_6": "Specialist works (no consultation with other agents)",
    "step_7": "Return result to RAM",
    "step_8": "RAM summarizes for user",
    "step_9": "Log to proof + memory for synthesis"
  },

  "token_budget_per_specialist": {
    "supabase": 3000,
    "vercel": 2500,
    "figma": 2000,
    "uiux-pro": 3000,
    "cloudflare": 2500,
    "iot": 3000
  }
}
