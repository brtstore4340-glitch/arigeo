{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/fleet-registry/fleet-session-init.sh\"",
            "statusMessage": "Initializing fleet registry context..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'skill=$(cat | grep -oE \"\\\"skill\\\"[[:space:]]*:[[:space:]]*\\\"[^\\\"]*\\\"\" | sed -E \"s/.*:[[:space:]]*\\\"([^\\\"]*)\\\"/\\1/\"); if [[ \"$skill\" =~ ^(fleet-awaken|awaken)$ ]] && [ -f \"${CLAUDE_PROJECT_DIR}/.claude/fleet-registry/oracles.json\" ]; then echo \"✓ Fleet registry active\"; fi'",
            "statusMessage": "Checking fleet registry..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(source *fleet-init.sh)",
      "Bash(jq *oracles.json)",
      "Read(.claude/fleet-registry/*)"
    ]
  }
}
